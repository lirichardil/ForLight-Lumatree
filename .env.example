# ---------------------------------------------------------------------------
# Catalogue source
#
# Picks which backend answers getAllProducts / getProductBySlug.
#   prisma   local SQLite, the interim store (default)
#   shopify  Storefront API, the destination
#
# The switch is explicit on purpose. It does not infer "use Shopify" from the
# presence of credentials, because a misspelled token would then fall back to
# SQLite silently and reach production looking like stale data.
# ---------------------------------------------------------------------------
CATALOGUE_SOURCE="prisma"

# ---------------------------------------------------------------------------
# Prisma / SQLite  (needed while CATALOGUE_SOURCE=prisma)
#
# Not loaded automatically by Prisma — see prisma.config.ts.
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Shopify Storefront API  (needed once CATALOGUE_SOURCE=shopify)
#
# Get the token from the Shopify admin: Settings -> Apps and sales channels ->
# Develop apps -> create an app -> Storefront API access token. It is a public
# token, safe to expose, but there is no reason to ship it to the browser —
# every call here runs server-side, so it is deliberately not NEXT_PUBLIC_.
#
# Required Storefront API scopes: unauthenticated_read_product_listings.
# Add unauthenticated_write_checkouts when the cart is built.
# ---------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN="lumatree.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# Collection holding the six fixtures and nothing else — this is what keeps
# samples and spare parts off the catalogue pages. Set its sort order to
# MANUAL in the admin; dragging products there is what orders the site.
SHOPIFY_FIXTURES_COLLECTION="fixtures"

# Shopify versions its API quarterly and supports each release for twelve
# months. Pin deliberately and bump on purpose. Check the current stable
# version before going live.
SHOPIFY_API_VERSION="2025-10"
